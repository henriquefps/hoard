    <!-- Phase 2d: the import bridge of the side-by-side build (Hoard Next next to Hoard 1). -->
    <string name="import_bridge_permission">Read Hoard data for Hoard Next</string>
    <string name="import_offer_title">Bring your data from Hoard</string>
    <string name="import_offer_text">Hoard %1$s is on this phone. Hoard Next can copy its machines, favorites, transfers and culling decisions. Hoard keeps working as it is: nothing in it changes.</string>
    <string name="import_offer_brings">What comes over</string>
    <string name="import_offer_passwords_note">Passwords cannot come over: each app keeps them in its own keystore. Hoard Next asks for each machine\'s password once, right after the import.</string>
    <string name="import_offer_import">Import from Hoard</string>
    <string name="import_offer_fresh">Start without importing</string>
    <string name="import_offer_update_title">Update Hoard to bring your data</string>
    <string name="import_offer_update_text">Hoard %1$s is on this phone. Hoard 1.11.0 or later hands its data to Hoard Next. Update it, then check again.</string>
    <string name="import_offer_check_again">Check again</string>
    <string name="import_offer_refused_title">Hoard did not share its data</string>
    <string name="import_offer_refused_text">The Hoard on this phone is not signed with the same key as Hoard Next (a test build next to a release, for example), so it keeps its data to itself. Install both from the same source, or start without importing.</string>
    <string name="import_done_text_bridge">Everything Hoard saved came over, except the passwords: each app keeps them in its own keystore.</string>
    <plurals name="import_done_passwords">
        <item quantity="one">%1$d machine needs its password. Hoard Next asks for it next.</item>
