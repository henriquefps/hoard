<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          Streaming: content://<applicationId>.stream/<token>/<name>, a seekable proxy file descriptor
          per open. Not exported; apps get in only through the one-off read grant on the intent.
        -->
        <provider
            android:name=".smb.stream.StreamProvider"
            android:authorities="${applicationId}.stream"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Keeps the process un-frozen while another app streams from Hoard or a page is served. -->
        <service
            android:name=".smb.stream.StreamService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- In-app viewer for HTML pages served by the local web server (127.0.0.1 only). -->
        <activity
            android:name=".smb.stream.WebViewerActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:exported="false"
            android:theme="@style/AppTheme.WebViewer" />

        <!-- HoardSmb transfers: WorkManager's foreground service runs as a dataSync service. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Cancel action of the transfer notification (only reachable through our PendingIntent). -->
        <receiver
            android:name=".smb.transfer.TransferCancelReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <!-- SMB over TCP, probes. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- networkChanged (default network callback) and WorkManager's network constraint. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- discover: multicast lock while browsing _smb._tcp with NSD (mDNS). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Transfers keep running with the screen off / app closed as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Transfer progress notification (Android 13+, asked at the first download). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Locations (ADR 0005): browse the phone's storage, USB drives and SD cards as a file manager.
      Android 11+: "All files access" (MANAGE_EXTERNAL_STORAGE), a Settings switch the user turns on
      from the first-run screen. Hoard is sideloaded; Google Play only allows this permission for
      apps whose core purpose is file management, after a declaration review (see the ADR).
      Android 10 and older: the storage runtime permissions (legacy external storage on 10).
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Tells USB drives from SD cards (mass-storage USB devices attached). Not required. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- openFile / "tap to open" need to see which apps can view a file (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- "Open in browser" for pages served by the local web server. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
