{
  "name": "hoard",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "android:sync": "bun run build && cap sync android",
    "android:debug": "bun run android:sync && cd android && ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" ./gradlew assembleDebug",
    "android:release": "bun run android:sync && cd android && ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}\" JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" skv run hoard -- ./gradlew assembleRelease",
    "android:install": "bun run android:debug && \"${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb\" install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.0.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-flexible-markers": "^1.3.6",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-supersub": "^1.0.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "sql.js": "^1.15.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
